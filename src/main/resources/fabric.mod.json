{
  "schemaVersion": 1,
  "id": "chat-remastered",
  "version": "${version}",
  "name": "Chat Remastered",
  "description": "Enhances Minecraft chat with image sharing, fullscreen chat mode, customizable chat height, and more.",
  "authors": ["Errnick_"],
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "dev.errnicraft.chatremastered.ChatRemasteredMod"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.errnicraft.chatremastered.ChatRemasteredClient"
      }
    ]
  },
  "mixins": [
    "chat-remastered.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.0+kotlin.2.3.20",
    "minecraft": "~1.21.11"
  }
}
